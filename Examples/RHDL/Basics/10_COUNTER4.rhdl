# 4-bit synchronous counter using the Reg4 example.
circuit Counter4
    input EN, CLK, RESET
    output Q: 4
    output ZERO

    signal q_i: 4
    signal next: 4

    next = choose(EN, q_i + 0x1, q_i)

    component reg : Reg4(D=next, WE=1, CLK=CLK, RESET=RESET, Q=q_i)

    Q = q_i
    ZERO = q_i == 0x0
end
