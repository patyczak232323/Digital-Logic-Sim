# Active-low NAND SR latch.
# SET_N=RESET_N=1 holds the previous state.
circuit SrLatch
    input SET_N, RESET_N
    output Q, NOT_Q

    signal q_i
    signal nq_i

    component q_gate : NAND(IN_A=SET_N, IN_B=nq_i, OUT=q_i)
    component nq_gate : NAND(IN_A=RESET_N, IN_B=q_i, OUT=nq_i)

    Q = q_i
    NOT_Q = nq_i
end
