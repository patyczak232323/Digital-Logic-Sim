# Intel 4004 compatible core for Rewired / RHDL v0.6
#
# Functional ISA-level implementation of the Intel 4004 architecture.
# It intentionally uses a clean Rewired interface instead of reproducing
# the original MCS-4 multiplexed electrical bus timing transistor-for-transistor.
# All architectural state is built directly from NAND master/slave D flip-flops.
# No custom DffBit/Reg4/RAM component must be built before this source.
#
# Program interface: 12-bit address = ROM_ADDR_HIGH:ROM_ADDR_LOW, 8-bit ROM_DATA.
# Data/I/O interface is decoded from SRC/DCL state and E-group instructions.

circuit Intel4004
    input CLK
    input RESET
    input TEST
    input ROM_DATA: 8
    input RAM_DATA_IN: 4
    input RAM_STATUS_IN: 4
    input ROM_PORT_IN: 4

    output ROM_ADDR_LOW: 8
    output ROM_ADDR_HIGH: 4
    output RAM_ADDR: 8
    output RAM_BANK: 4
    output RAM_STATUS_INDEX: 4
    output RAM_DATA_OUT: 4
    output RAM_STATUS_OUT: 4
    output RAM_PORT_OUT: 4
    output ROM_PORT_OUT: 4
    output PROGRAM_DATA_OUT: 4
    output RAM_WRITE
    output RAM_STATUS_WRITE
    output RAM_PORT_WRITE
    output ROM_PORT_WRITE
    output PROGRAM_WRITE
    output ACC_OUT: 4
    output CARRY_OUT
    output SRC_OUT: 8
    output PC_LOW_OUT: 8
    output PC_HIGH_OUT: 4
    output PHASE_OUT: 4
    output R0_OUT: 4
    output R1_OUT: 4
    output R2_OUT: 4
    output R3_OUT: 4
    output R4_OUT: 4
    output R5_OUT: 4
    output R6_OUT: 4
    output R7_OUT: 4
    output R8_OUT: 4
    output R9_OUT: 4
    output R10_OUT: 4
    output R11_OUT: 4
    output R12_OUT: 4
    output R13_OUT: 4
    output R14_OUT: 4
    output R15_OUT: 4

    # Shared inverted clock for all NAND master/slave flip-flops.
    signal nclk = not CLK

    signal acc_q: 4
    signal acc_d: 4
    signal carry_q
    signal carry_d
    signal r0_q: 4
    signal r0_d: 4
    signal r1_q: 4
    signal r1_d: 4
    signal r2_q: 4
    signal r2_d: 4
    signal r3_q: 4
    signal r3_d: 4
    signal r4_q: 4
    signal r4_d: 4
    signal r5_q: 4
    signal r5_d: 4
    signal r6_q: 4
    signal r6_d: 4
    signal r7_q: 4
    signal r7_d: 4
    signal r8_q: 4
    signal r8_d: 4
    signal r9_q: 4
    signal r9_d: 4
    signal r10_q: 4
    signal r10_d: 4
    signal r11_q: 4
    signal r11_d: 4
    signal r12_q: 4
    signal r12_d: 4
    signal r13_q: 4
    signal r13_d: 4
    signal r14_q: 4
    signal r14_d: 4
    signal r15_q: 4
    signal r15_d: 4
    signal pc_lo_q: 8
    signal pc_lo_d: 8
    signal pc_hi_q: 4
    signal pc_hi_d: 4
    signal st0_lo_q: 8
    signal st0_lo_d: 8
    signal st0_hi_q: 4
    signal st0_hi_d: 4
    signal st1_lo_q: 8
    signal st1_lo_d: 8
    signal st1_hi_q: 4
    signal st1_hi_d: 4
    signal st2_lo_q: 8
    signal st2_lo_d: 8
    signal st2_hi_q: 4
    signal st2_hi_d: 4
    signal src_q: 8
    signal src_d: 8
    signal bank_q: 4
    signal bank_d: 4
    signal phase_q: 4
    signal phase_d: 4
    signal pending_group_q: 4
    signal pending_group_d: 4
    signal pending_opa_q: 4
    signal pending_opa_d: 4

    # Current instruction fields.
    signal op: 4 = ROM_DATA[7:4]
    signal opa: 4 = ROM_DATA[3:0]
    signal phase0 = phase_q == 0x0
    signal phase1 = phase_q == 0x1
    signal phase2 = phase_q == 0x2
    signal opa_even = not opa[0]
    signal raw_fim = (op == 0x2) and opa_even
    signal raw_src = (op == 0x2) and opa[0]
    signal raw_fin = (op == 0x3) and opa_even
    signal raw_jin = (op == 0x3) and opa[0]
    signal enter_two = phase0 and ((op == 0x1) or raw_fim or (op == 0x4) or (op == 0x5) or (op == 0x7))
    signal enter_fin = phase0 and raw_fin
    signal latch_pending = enter_two or enter_fin

    signal reg_sel: 4 = choose(opa == 0x0, r0_q, choose(opa == 0x1, r1_q, choose(opa == 0x2, r2_q, choose(opa == 0x3, r3_q, choose(opa == 0x4, r4_q, choose(opa == 0x5, r5_q, choose(opa == 0x6, r6_q, choose(opa == 0x7, r7_q, choose(opa == 0x8, r8_q, choose(opa == 0x9, r9_q, choose(opa == 0xA, r10_q, choose(opa == 0xB, r11_q, choose(opa == 0xC, r12_q, choose(opa == 0xD, r13_q, choose(opa == 0xE, r14_q, r15_q)))))))))))))))
    signal pending_reg: 4 = choose(pending_opa_q == 0x0, r0_q, choose(pending_opa_q == 0x1, r1_q, choose(pending_opa_q == 0x2, r2_q, choose(pending_opa_q == 0x3, r3_q, choose(pending_opa_q == 0x4, r4_q, choose(pending_opa_q == 0x5, r5_q, choose(pending_opa_q == 0x6, r6_q, choose(pending_opa_q == 0x7, r7_q, choose(pending_opa_q == 0x8, r8_q, choose(pending_opa_q == 0x9, r9_q, choose(pending_opa_q == 0xA, r10_q, choose(pending_opa_q == 0xB, r11_q, choose(pending_opa_q == 0xC, r12_q, choose(pending_opa_q == 0xD, r13_q, choose(pending_opa_q == 0xE, r14_q, r15_q)))))))))))))))

    signal pair_sel: 8 = choose(opa < 0x2, join(r0_q, r1_q), choose(opa < 0x4, join(r2_q, r3_q), choose(opa < 0x6, join(r4_q, r5_q), choose(opa < 0x8, join(r6_q, r7_q), choose(opa < 0xA, join(r8_q, r9_q), choose(opa < 0xC, join(r10_q, r11_q), choose(opa < 0xE, join(r12_q, r13_q), join(r14_q, r15_q))))))))
    signal pending_pair: 8 = choose(pending_opa_q < 0x2, join(r0_q, r1_q), choose(pending_opa_q < 0x4, join(r2_q, r3_q), choose(pending_opa_q < 0x6, join(r4_q, r5_q), choose(pending_opa_q < 0x8, join(r6_q, r7_q), choose(pending_opa_q < 0xA, join(r8_q, r9_q), choose(pending_opa_q < 0xC, join(r10_q, r11_q), choose(pending_opa_q < 0xE, join(r12_q, r13_q), join(r14_q, r15_q))))))))

    signal pc_lo_inc: 8 = pc_lo_q + 0x01
    signal pc_lo_wrap = pc_lo_q == 0xFF
    signal pc_hi_plus: 4 = pc_hi_q + 0x1
    signal pc_hi_inc: 4 = choose(pc_lo_wrap, pc_hi_plus, pc_hi_q)
    signal pc2_lo: 8 = pc_lo_q + 0x01
    signal pc2_wrap = pc_lo_q == 0xFF
    signal pc2_hi_plus: 4 = pc_hi_q + 0x1
    signal pc2_hi: 4 = choose(pc2_wrap, pc2_hi_plus, pc_hi_q)

    signal jcn_acc_zero = acc_q == 0x0
    signal jcn_test_zero = TEST == 0
    signal jcn_base = (pending_opa_q[2] and jcn_acc_zero) or (pending_opa_q[1] and carry_q) or (pending_opa_q[0] and jcn_test_zero)
    signal jcn_take = choose(pending_opa_q[3], not jcn_base, jcn_base)
    signal isz_result: 4 = pending_reg + 0x1
    signal isz_take = isz_result != 0x0

    signal carry4: 4 = choose(carry_q, 0x1, 0x0)
    signal add_s1: 4 = acc_q + reg_sel
    signal add_c1 = add_s1 < acc_q
    signal add_result: 4 = add_s1 + carry4
    signal add_c2 = add_result < add_s1
    signal add_carry = add_c1 or add_c2
    signal sub_s1: 4 = acc_q - reg_sel
    signal sub_result: 4 = sub_s1 - carry4
    signal sub_carry = choose(carry_q, acc_q > reg_sel, acc_q >= reg_sel)
    signal adm_s1: 4 = acc_q + RAM_DATA_IN
    signal adm_c1 = adm_s1 < acc_q
    signal adm_result: 4 = adm_s1 + carry4
    signal adm_c2 = adm_result < adm_s1
    signal adm_carry = adm_c1 or adm_c2
    signal sbm_s1: 4 = acc_q - RAM_DATA_IN
    signal sbm_result: 4 = sbm_s1 - carry4
    signal sbm_carry = choose(carry_q, acc_q > RAM_DATA_IN, acc_q >= RAM_DATA_IN)
    signal iac_result: 4 = acc_q + 0x1
    signal iac_carry = acc_q == 0xF
    signal dac_result: 4 = acc_q - 0x1
    signal dac_carry = acc_q != 0x0
    signal ral_result: 4 = join(acc_q[2], acc_q[1], acc_q[0], carry_q)
    signal rar_result: 4 = join(carry_q, acc_q[3], acc_q[2], acc_q[1])
    signal tcc_result: 4 = join(0, 0, 0, carry_q)
    signal tcs_result: 4 = choose(carry_q, 0xA, 0x9)
    signal daa_do = carry_q or (acc_q > 0x9)
    signal daa_sum: 4 = acc_q + 0x6
    signal daa_result: 4 = choose(daa_do, daa_sum, acc_q)
    signal daa_carry = choose(daa_do, 1, carry_q)
    signal kbp_result: 4 = choose(acc_q == 0x0, 0x0, choose(acc_q == 0x1, 0x1, choose(acc_q == 0x2, 0x2, choose(acc_q == 0x4, 0x3, choose(acc_q == 0x8, 0x4, 0xF)))))

    signal ex_inc = phase0 and (op == 0x6)
    signal ex_add = phase0 and (op == 0x8)
    signal ex_sub = phase0 and (op == 0x9)
    signal ex_ld = phase0 and (op == 0xA)
    signal ex_xch = phase0 and (op == 0xB)
    signal ex_bbl = phase0 and (op == 0xC)
    signal ex_ldm = phase0 and (op == 0xD)
    signal ex_jin = phase0 and raw_jin
    signal ex_src = phase0 and raw_src
    signal ex_e = phase0 and (op == 0xE)
    signal ex_f = phase0 and (op == 0xF)
    signal e_wrm = ex_e and (opa == 0x0)
    signal e_wmp = ex_e and (opa == 0x1)
    signal e_wrr = ex_e and (opa == 0x2)
    signal e_wpm = ex_e and (opa == 0x3)
    signal e_wr0 = ex_e and (opa == 0x4)
    signal e_wr1 = ex_e and (opa == 0x5)
    signal e_wr2 = ex_e and (opa == 0x6)
    signal e_wr3 = ex_e and (opa == 0x7)
    signal e_sbm = ex_e and (opa == 0x8)
    signal e_rdm = ex_e and (opa == 0x9)
    signal e_rdr = ex_e and (opa == 0xA)
    signal e_adm = ex_e and (opa == 0xB)
    signal e_rd0 = ex_e and (opa == 0xC)
    signal e_rd1 = ex_e and (opa == 0xD)
    signal e_rd2 = ex_e and (opa == 0xE)
    signal e_rd3 = ex_e and (opa == 0xF)
    signal f_clb = ex_f and (opa == 0x0)
    signal f_clc = ex_f and (opa == 0x1)
    signal f_iac = ex_f and (opa == 0x2)
    signal f_cmc = ex_f and (opa == 0x3)
    signal f_cma = ex_f and (opa == 0x4)
    signal f_ral = ex_f and (opa == 0x5)
    signal f_rar = ex_f and (opa == 0x6)
    signal f_tcc = ex_f and (opa == 0x7)
    signal f_dac = ex_f and (opa == 0x8)
    signal f_tcs = ex_f and (opa == 0x9)
    signal f_stc = ex_f and (opa == 0xA)
    signal f_daa = ex_f and (opa == 0xB)
    signal f_kbp = ex_f and (opa == 0xC)
    signal f_dcl = ex_f and (opa == 0xD)
    signal second_jcn = phase1 and (pending_group_q == 0x1)
    signal second_fim = phase1 and (pending_group_q == 0x2)
    signal second_jun = phase1 and (pending_group_q == 0x4)
    signal second_jms = phase1 and (pending_group_q == 0x5)
    signal second_isz = phase1 and (pending_group_q == 0x7)

    acc_d = choose(RESET, 0x0, choose(ex_add, add_result, choose(ex_sub, sub_result, choose(ex_ld, reg_sel, choose(ex_xch, reg_sel, choose(ex_bbl, opa, choose(ex_ldm, opa, choose(e_sbm, sbm_result, choose(e_rdm, RAM_DATA_IN, choose(e_rdr, ROM_PORT_IN, choose(e_adm, adm_result, choose(e_rd0 or e_rd1 or e_rd2 or e_rd3, RAM_STATUS_IN, choose(f_clb, 0x0, choose(f_iac, iac_result, choose(f_cma, not acc_q, choose(f_ral, ral_result, choose(f_rar, rar_result, choose(f_tcc, tcc_result, choose(f_dac, dac_result, choose(f_tcs, tcs_result, choose(f_daa, daa_result, choose(f_kbp, kbp_result, acc_q))))))))))))))))))))))
    carry_d = choose(RESET, 0, choose(ex_add, add_carry, choose(ex_sub, sub_carry, choose(e_sbm, sbm_carry, choose(e_adm, adm_carry, choose(f_clb, 0, choose(f_clc, 0, choose(f_iac, iac_carry, choose(f_cmc, not carry_q, choose(f_ral, acc_q[3], choose(f_rar, acc_q[0], choose(f_tcc, 0, choose(f_dac, dac_carry, choose(f_tcs, 0, choose(f_stc, 1, choose(f_daa, daa_carry, carry_q))))))))))))))))

    signal r0_write_pair = (second_fim or phase2) and (pending_opa_q == 0x0)
    signal r0_write_inc = (ex_inc and (opa == 0x0)) or (second_isz and (pending_opa_q == 0x0))
    signal r0_write_xch = ex_xch and (opa == 0x0)
    signal r0_inc: 4 = r0_q + 0x1
    r0_d = choose(RESET, 0x0, choose(r0_write_pair, ROM_DATA[7:4], choose(r0_write_inc, r0_inc, choose(r0_write_xch, acc_q, r0_q))))
    signal r1_write_pair = (second_fim or phase2) and (pending_opa_q == 0x0)
    signal r1_write_inc = (ex_inc and (opa == 0x1)) or (second_isz and (pending_opa_q == 0x1))
    signal r1_write_xch = ex_xch and (opa == 0x1)
    signal r1_inc: 4 = r1_q + 0x1
    r1_d = choose(RESET, 0x0, choose(r1_write_pair, ROM_DATA[3:0], choose(r1_write_inc, r1_inc, choose(r1_write_xch, acc_q, r1_q))))
    signal r2_write_pair = (second_fim or phase2) and (pending_opa_q == 0x2)
    signal r2_write_inc = (ex_inc and (opa == 0x2)) or (second_isz and (pending_opa_q == 0x2))
    signal r2_write_xch = ex_xch and (opa == 0x2)
    signal r2_inc: 4 = r2_q + 0x1
    r2_d = choose(RESET, 0x0, choose(r2_write_pair, ROM_DATA[7:4], choose(r2_write_inc, r2_inc, choose(r2_write_xch, acc_q, r2_q))))
    signal r3_write_pair = (second_fim or phase2) and (pending_opa_q == 0x2)
    signal r3_write_inc = (ex_inc and (opa == 0x3)) or (second_isz and (pending_opa_q == 0x3))
    signal r3_write_xch = ex_xch and (opa == 0x3)
    signal r3_inc: 4 = r3_q + 0x1
    r3_d = choose(RESET, 0x0, choose(r3_write_pair, ROM_DATA[3:0], choose(r3_write_inc, r3_inc, choose(r3_write_xch, acc_q, r3_q))))
    signal r4_write_pair = (second_fim or phase2) and (pending_opa_q == 0x4)
    signal r4_write_inc = (ex_inc and (opa == 0x4)) or (second_isz and (pending_opa_q == 0x4))
    signal r4_write_xch = ex_xch and (opa == 0x4)
    signal r4_inc: 4 = r4_q + 0x1
    r4_d = choose(RESET, 0x0, choose(r4_write_pair, ROM_DATA[7:4], choose(r4_write_inc, r4_inc, choose(r4_write_xch, acc_q, r4_q))))
    signal r5_write_pair = (second_fim or phase2) and (pending_opa_q == 0x4)
    signal r5_write_inc = (ex_inc and (opa == 0x5)) or (second_isz and (pending_opa_q == 0x5))
    signal r5_write_xch = ex_xch and (opa == 0x5)
    signal r5_inc: 4 = r5_q + 0x1
    r5_d = choose(RESET, 0x0, choose(r5_write_pair, ROM_DATA[3:0], choose(r5_write_inc, r5_inc, choose(r5_write_xch, acc_q, r5_q))))
    signal r6_write_pair = (second_fim or phase2) and (pending_opa_q == 0x6)
    signal r6_write_inc = (ex_inc and (opa == 0x6)) or (second_isz and (pending_opa_q == 0x6))
    signal r6_write_xch = ex_xch and (opa == 0x6)
    signal r6_inc: 4 = r6_q + 0x1
    r6_d = choose(RESET, 0x0, choose(r6_write_pair, ROM_DATA[7:4], choose(r6_write_inc, r6_inc, choose(r6_write_xch, acc_q, r6_q))))
    signal r7_write_pair = (second_fim or phase2) and (pending_opa_q == 0x6)
    signal r7_write_inc = (ex_inc and (opa == 0x7)) or (second_isz and (pending_opa_q == 0x7))
    signal r7_write_xch = ex_xch and (opa == 0x7)
    signal r7_inc: 4 = r7_q + 0x1
    r7_d = choose(RESET, 0x0, choose(r7_write_pair, ROM_DATA[3:0], choose(r7_write_inc, r7_inc, choose(r7_write_xch, acc_q, r7_q))))
    signal r8_write_pair = (second_fim or phase2) and (pending_opa_q == 0x8)
    signal r8_write_inc = (ex_inc and (opa == 0x8)) or (second_isz and (pending_opa_q == 0x8))
    signal r8_write_xch = ex_xch and (opa == 0x8)
    signal r8_inc: 4 = r8_q + 0x1
    r8_d = choose(RESET, 0x0, choose(r8_write_pair, ROM_DATA[7:4], choose(r8_write_inc, r8_inc, choose(r8_write_xch, acc_q, r8_q))))
    signal r9_write_pair = (second_fim or phase2) and (pending_opa_q == 0x8)
    signal r9_write_inc = (ex_inc and (opa == 0x9)) or (second_isz and (pending_opa_q == 0x9))
    signal r9_write_xch = ex_xch and (opa == 0x9)
    signal r9_inc: 4 = r9_q + 0x1
    r9_d = choose(RESET, 0x0, choose(r9_write_pair, ROM_DATA[3:0], choose(r9_write_inc, r9_inc, choose(r9_write_xch, acc_q, r9_q))))
    signal r10_write_pair = (second_fim or phase2) and (pending_opa_q == 0xA)
    signal r10_write_inc = (ex_inc and (opa == 0xA)) or (second_isz and (pending_opa_q == 0xA))
    signal r10_write_xch = ex_xch and (opa == 0xA)
    signal r10_inc: 4 = r10_q + 0x1
    r10_d = choose(RESET, 0x0, choose(r10_write_pair, ROM_DATA[7:4], choose(r10_write_inc, r10_inc, choose(r10_write_xch, acc_q, r10_q))))
    signal r11_write_pair = (second_fim or phase2) and (pending_opa_q == 0xA)
    signal r11_write_inc = (ex_inc and (opa == 0xB)) or (second_isz and (pending_opa_q == 0xB))
    signal r11_write_xch = ex_xch and (opa == 0xB)
    signal r11_inc: 4 = r11_q + 0x1
    r11_d = choose(RESET, 0x0, choose(r11_write_pair, ROM_DATA[3:0], choose(r11_write_inc, r11_inc, choose(r11_write_xch, acc_q, r11_q))))
    signal r12_write_pair = (second_fim or phase2) and (pending_opa_q == 0xC)
    signal r12_write_inc = (ex_inc and (opa == 0xC)) or (second_isz and (pending_opa_q == 0xC))
    signal r12_write_xch = ex_xch and (opa == 0xC)
    signal r12_inc: 4 = r12_q + 0x1
    r12_d = choose(RESET, 0x0, choose(r12_write_pair, ROM_DATA[7:4], choose(r12_write_inc, r12_inc, choose(r12_write_xch, acc_q, r12_q))))
    signal r13_write_pair = (second_fim or phase2) and (pending_opa_q == 0xC)
    signal r13_write_inc = (ex_inc and (opa == 0xD)) or (second_isz and (pending_opa_q == 0xD))
    signal r13_write_xch = ex_xch and (opa == 0xD)
    signal r13_inc: 4 = r13_q + 0x1
    r13_d = choose(RESET, 0x0, choose(r13_write_pair, ROM_DATA[3:0], choose(r13_write_inc, r13_inc, choose(r13_write_xch, acc_q, r13_q))))
    signal r14_write_pair = (second_fim or phase2) and (pending_opa_q == 0xE)
    signal r14_write_inc = (ex_inc and (opa == 0xE)) or (second_isz and (pending_opa_q == 0xE))
    signal r14_write_xch = ex_xch and (opa == 0xE)
    signal r14_inc: 4 = r14_q + 0x1
    r14_d = choose(RESET, 0x0, choose(r14_write_pair, ROM_DATA[7:4], choose(r14_write_inc, r14_inc, choose(r14_write_xch, acc_q, r14_q))))
    signal r15_write_pair = (second_fim or phase2) and (pending_opa_q == 0xE)
    signal r15_write_inc = (ex_inc and (opa == 0xF)) or (second_isz and (pending_opa_q == 0xF))
    signal r15_write_xch = ex_xch and (opa == 0xF)
    signal r15_inc: 4 = r15_q + 0x1
    r15_d = choose(RESET, 0x0, choose(r15_write_pair, ROM_DATA[3:0], choose(r15_write_inc, r15_inc, choose(r15_write_xch, acc_q, r15_q))))

    src_d = choose(RESET, 0x00, choose(ex_src, pair_sel, src_q))
    # DCL stores the low three accumulator bits as CM-RAM command lines.
    # For this clean external interface expose the resulting logical bank 0..7.
    signal dcl_code: 4 = acc_q and 0x7
    signal dcl_bank: 4 = choose(dcl_code == 0x3, 0x4, choose(dcl_code == 0x4, 0x3, dcl_code))
    bank_d = choose(RESET, 0x0, choose(f_dcl, dcl_bank, bank_q))
    pending_group_d = choose(RESET, 0x0, choose(latch_pending, op, pending_group_q))
    pending_opa_d = choose(RESET, 0x0, choose(latch_pending, opa, pending_opa_q))
    phase_d = choose(RESET, 0x0, choose(phase0, choose(enter_fin, 0x2, choose(enter_two, 0x1, 0x0)), 0x0))

    signal pc0_lo_next: 8 = choose(ex_jin, pair_sel, choose(ex_bbl, st0_lo_q, pc_lo_inc))
    signal pc0_hi_next: 4 = choose(ex_jin, pc_hi_inc, choose(ex_bbl, st0_hi_q, pc_hi_inc))
    signal pc1_branch_page: 4 = pc2_hi
    signal pc1_lo_jcn: 8 = choose(jcn_take, ROM_DATA, pc2_lo)
    signal pc1_hi_jcn: 4 = pc1_branch_page
    signal pc1_lo_isz: 8 = choose(isz_take, ROM_DATA, pc2_lo)
