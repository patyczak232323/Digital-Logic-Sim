    component pending_opa_b0_mreset : NAND(IN_A=pending_opa_b0_not_d, IN_B=nclk, OUT=pending_opa_b0_m_reset_n)
    component pending_opa_b0_mq : NAND(IN_A=pending_opa_b0_m_set_n, IN_B=pending_opa_b0_m_nq, OUT=pending_opa_b0_m_q)
    component pending_opa_b0_mnq : NAND(IN_A=pending_opa_b0_m_reset_n, IN_B=pending_opa_b0_m_q, OUT=pending_opa_b0_m_nq)
    component pending_opa_b0_sset : NAND(IN_A=pending_opa_b0_m_q, IN_B=CLK, OUT=pending_opa_b0_s_set_n)
    component pending_opa_b0_sreset : NAND(IN_A=pending_opa_b0_not_m_q, IN_B=CLK, OUT=pending_opa_b0_s_reset_n)
    component pending_opa_b0_sq : NAND(IN_A=pending_opa_b0_s_set_n, IN_B=pending_opa_b0_s_nq, OUT=pending_opa_q0)
    component pending_opa_b0_snq : NAND(IN_A=pending_opa_b0_s_reset_n, IN_B=pending_opa_q0, OUT=pending_opa_b0_s_nq)
    signal pending_opa_b1_d_bit = pending_opa_d[1]
    signal pending_opa_b1_not_d = not pending_opa_b1_d_bit
    signal pending_opa_b1_m_set_n
    signal pending_opa_b1_m_reset_n
    signal pending_opa_b1_m_q
    signal pending_opa_b1_m_nq
    signal pending_opa_b1_not_m_q = not pending_opa_b1_m_q
    signal pending_opa_b1_s_set_n
    signal pending_opa_b1_s_reset_n
    signal pending_opa_b1_s_nq
    component pending_opa_b1_mset : NAND(IN_A=pending_opa_b1_d_bit, IN_B=nclk, OUT=pending_opa_b1_m_set_n)
    component pending_opa_b1_mreset : NAND(IN_A=pending_opa_b1_not_d, IN_B=nclk, OUT=pending_opa_b1_m_reset_n)
    component pending_opa_b1_mq : NAND(IN_A=pending_opa_b1_m_set_n, IN_B=pending_opa_b1_m_nq, OUT=pending_opa_b1_m_q)
    component pending_opa_b1_mnq : NAND(IN_A=pending_opa_b1_m_reset_n, IN_B=pending_opa_b1_m_q, OUT=pending_opa_b1_m_nq)
    component pending_opa_b1_sset : NAND(IN_A=pending_opa_b1_m_q, IN_B=CLK, OUT=pending_opa_b1_s_set_n)
    component pending_opa_b1_sreset : NAND(IN_A=pending_opa_b1_not_m_q, IN_B=CLK, OUT=pending_opa_b1_s_reset_n)
    component pending_opa_b1_sq : NAND(IN_A=pending_opa_b1_s_set_n, IN_B=pending_opa_b1_s_nq, OUT=pending_opa_q1)
    component pending_opa_b1_snq : NAND(IN_A=pending_opa_b1_s_reset_n, IN_B=pending_opa_q1, OUT=pending_opa_b1_s_nq)
    signal pending_opa_b2_d_bit = pending_opa_d[2]
    signal pending_opa_b2_not_d = not pending_opa_b2_d_bit
    signal pending_opa_b2_m_set_n
    signal pending_opa_b2_m_reset_n
    signal pending_opa_b2_m_q
    signal pending_opa_b2_m_nq
    signal pending_opa_b2_not_m_q = not pending_opa_b2_m_q
    signal pending_opa_b2_s_set_n
    signal pending_opa_b2_s_reset_n
    signal pending_opa_b2_s_nq
    component pending_opa_b2_mset : NAND(IN_A=pending_opa_b2_d_bit, IN_B=nclk, OUT=pending_opa_b2_m_set_n)
    component pending_opa_b2_mreset : NAND(IN_A=pending_opa_b2_not_d, IN_B=nclk, OUT=pending_opa_b2_m_reset_n)
    component pending_opa_b2_mq : NAND(IN_A=pending_opa_b2_m_set_n, IN_B=pending_opa_b2_m_nq, OUT=pending_opa_b2_m_q)
    component pending_opa_b2_mnq : NAND(IN_A=pending_opa_b2_m_reset_n, IN_B=pending_opa_b2_m_q, OUT=pending_opa_b2_m_nq)
    component pending_opa_b2_sset : NAND(IN_A=pending_opa_b2_m_q, IN_B=CLK, OUT=pending_opa_b2_s_set_n)
    component pending_opa_b2_sreset : NAND(IN_A=pending_opa_b2_not_m_q, IN_B=CLK, OUT=pending_opa_b2_s_reset_n)
    component pending_opa_b2_sq : NAND(IN_A=pending_opa_b2_s_set_n, IN_B=pending_opa_b2_s_nq, OUT=pending_opa_q2)
    component pending_opa_b2_snq : NAND(IN_A=pending_opa_b2_s_reset_n, IN_B=pending_opa_q2, OUT=pending_opa_b2_s_nq)
    signal pending_opa_b3_d_bit = pending_opa_d[3]
    signal pending_opa_b3_not_d = not pending_opa_b3_d_bit
    signal pending_opa_b3_m_set_n
    signal pending_opa_b3_m_reset_n
    signal pending_opa_b3_m_q
    signal pending_opa_b3_m_nq
    signal pending_opa_b3_not_m_q = not pending_opa_b3_m_q
    signal pending_opa_b3_s_set_n
    signal pending_opa_b3_s_reset_n
    signal pending_opa_b3_s_nq
    component pending_opa_b3_mset : NAND(IN_A=pending_opa_b3_d_bit, IN_B=nclk, OUT=pending_opa_b3_m_set_n)
