    component pending_opa_b3_mnq : NAND(IN_A=pending_opa_b3_m_reset_n, IN_B=pending_opa_b3_m_q, OUT=pending_opa_b3_m_nq)
    component pending_opa_b3_sset : NAND(IN_A=pending_opa_b3_m_q, IN_B=CLK, OUT=pending_opa_b3_s_set_n)
    component pending_opa_b3_sreset : NAND(IN_A=pending_opa_b3_not_m_q, IN_B=CLK, OUT=pending_opa_b3_s_reset_n)
    component pending_opa_b3_sq : NAND(IN_A=pending_opa_b3_s_set_n, IN_B=pending_opa_b3_s_nq, OUT=pending_opa_q3)
    component pending_opa_b3_snq : NAND(IN_A=pending_opa_b3_s_reset_n, IN_B=pending_opa_q3, OUT=pending_opa_b3_s_nq)


