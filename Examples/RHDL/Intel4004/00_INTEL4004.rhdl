    component pending_group_b3_snq : NAND(IN_A=pending_group_b3_s_reset_n, IN_B=pending_group_q3, OUT=pending_group_b3_s_nq)

    # State: pending_opa_q (4 bits)
    signal pending_opa_q0
    signal pending_opa_q1
    signal pending_opa_q2
    signal pending_opa_q3
    pending_opa_q = join(pending_opa_q3, pending_opa_q2, pending_opa_q1, pending_opa_q0)
    signal pending_opa_b0_d_bit = pending_opa_d[0]
    signal pending_opa_b0_not_d = not pending_opa_b0_d_bit
    signal pending_opa_b0_m_set_n
