# Rewired-8 CPU core for RW8 ISA v1, written for RHDL v0.5.
#
# External interfaces:
#   IMEM_* : Harvard instruction memory, 16-bit word split into HI/LO bytes.
#   DMEM_* : 64 KiB byte-addressed data memory, 16-bit address split HI/LO.
#
# Sequencing:
#   state 0 = FETCH  (IR <- IMEM[PC], PC <- PC+1)
#   state 1 = EXEC
#   state 2 = CALL second stack byte + branch
#   state 3 = RET second stack byte + PC restore
#   state 4 = HALT
#
# The already-canonical 6-bit opcode map is unchanged.
# Current hardware conventions for details that had not been fixed earlier:
#   - ADDI/SUBI/CMPI sign-extend imm7.
#   - Relative target is the already-incremented PC + signed rel10.
#   - Stack grows downward: PUSH/CALL pre-decrement, POP/RET post-increment.
#   - Shift/rotate update Z,N,C and preserve V.
#   - SWAP/BSET/BCLR/BTGL update Z,N and preserve C,V.
#   - BTST updates Z only.
circuit RW8_CORE:
    input CLK, RESET
    input IMEM_HI: 8, IMEM_LO: 8
    input DMEM_IN: 8

    output IMEM_ADDR_HI: 8, IMEM_ADDR_LO: 8
    output DMEM_ADDR_HI: 8, DMEM_ADDR_LO: 8
    output DMEM_OUT: 8
    output DMEM_WRITE, DMEM_READ
    output HALTED
    output FLAGS: 4
    output STATE: 8

    output DBG_PC_HI: 8, DBG_PC_LO: 8
    output DBG_IR_HI: 8, DBG_IR_LO: 8
    output DBG_X_HI: 8, DBG_X_LO: 8
    output DBG_Y_HI: 8, DBG_Y_LO: 8
    output DBG_SP_HI: 8, DBG_SP_LO: 8
    output DBG_R0: 8, DBG_R1: 8, DBG_R2: 8, DBG_R3: 8
    output DBG_R4: 8, DBG_R5: 8, DBG_R6: 8, DBG_R7: 8

    # ---- Sequencer and architectural state ----
    signal state_q: 8
    signal state_d: 8
    signal fetch
    signal exec
    signal call2
    signal ret2
    signal halted_state

    fetch = state_q == 0x00
    exec = state_q == 0x01
    call2 = state_q == 0x02
    ret2 = state_q == 0x03
    halted_state = state_q == 0x04

    component state_reg = RW8_REG8(D=state_d, WE=1, CLK=CLK, RESET=RESET, Q=state_q)

    signal ir_hi: 8
    signal ir_lo: 8
    component irh = RW8_REG8(D=IMEM_HI, WE=fetch, CLK=CLK, RESET=RESET, Q=ir_hi)
    component irl = RW8_REG8(D=IMEM_LO, WE=fetch, CLK=CLK, RESET=RESET, Q=ir_lo)

    signal pc_hi: 8
    signal pc_lo: 8
    signal next_pc_hi: 8
    signal next_pc_lo: 8
    signal pc_write
    component pc = RW8_REG16(D_LO=next_pc_lo, D_HI=next_pc_hi, WE=pc_write, CLK=CLK, RESET=RESET, Q_LO=pc_lo, Q_HI=pc_hi)

    signal x_hi: 8
    signal x_lo: 8
    signal x_d_hi: 8
    signal x_d_lo: 8
    signal x_we
    component xreg = RW8_REG16(D_LO=x_d_lo, D_HI=x_d_hi, WE=x_we, CLK=CLK, RESET=RESET, Q_LO=x_lo, Q_HI=x_hi)

    signal y_hi: 8
    signal y_lo: 8
    signal y_d_hi: 8
    signal y_d_lo: 8
    signal y_we
    component yreg = RW8_REG16(D_LO=y_d_lo, D_HI=y_d_hi, WE=y_we, CLK=CLK, RESET=RESET, Q_LO=y_lo, Q_HI=y_hi)

    signal sp_hi: 8
    signal sp_lo: 8
    signal sp_d_hi: 8
    signal sp_d_lo: 8
    signal sp_we
    component spreg = RW8_REG16(D_LO=sp_d_lo, D_HI=sp_d_hi, WE=sp_we, CLK=CLK, RESET=RESET, Q_LO=sp_lo, Q_HI=sp_hi)

    signal return_lo_saved: 8
    signal ret_capture
    component retlo = RW8_REG8(D=DMEM_IN, WE=ret_capture, CLK=CLK, RESET=RESET, Q=return_lo_saved)

    signal flags_q: 8
    signal flags_d: 8
    signal flags_we
    component flagsreg = RW8_REG8(D=flags_d, WE=flags_we, CLK=CLK, RESET=RESET, Q=flags_q)

    signal flag_z
    signal flag_c
    signal flag_n
    signal flag_v
    flag_z = flags_q[0]
    flag_c = flags_q[1]
    flag_n = flags_q[2]
    flag_v = flags_q[3]

    # ---- Instruction fields ----
    signal op4: 4
    signal g0
    signal g1
    signal g2
    signal g3

    op4 = ir_hi[5:2]
    g0 = not ir_hi[7] and not ir_hi[6]
    g1 = not ir_hi[7] and ir_hi[6]
    g2 = ir_hi[7] and not ir_hi[6]
    g3 = ir_hi[7] and ir_hi[6]

    signal rd0
    signal rd1
    signal rd2
    signal rs0
    signal rs1
    signal rs2

    rd2 = ir_hi[1]
    rd1 = ir_hi[0]
    rd0 = ir_lo[7]
    rs2 = ir_lo[6]
    rs1 = ir_lo[5]
    rs0 = ir_lo[4]

    signal imm7_se: 8
    signal ldi0_value: 8
    signal ldi1_value: 8
    signal rel_off_hi: 8

    imm7_se = join(ir_lo[6], ir_lo[6], ir_lo[5], ir_lo[4], ir_lo[3], ir_lo[2], ir_lo[1], ir_lo[0])
    ldi0_value = join(0, ir_lo[6], ir_lo[5], ir_lo[4], ir_lo[3], ir_lo[2], ir_lo[1], ir_lo[0])
    ldi1_value = join(1, ir_lo[6], ir_lo[5], ir_lo[4], ir_lo[3], ir_lo[2], ir_lo[1], ir_lo[0])
    rel_off_hi = join(ir_hi[1], ir_hi[1], ir_hi[1], ir_hi[1], ir_hi[1], ir_hi[1], ir_hi[1], ir_hi[0])

    # ---- Low four opcode decoder ----
    signal o0
    signal o1
    signal o2
    signal o3
    signal o4
    signal o5
    signal o6
    signal o7
    signal o8
    signal o9
    signal oA
    signal oB
    signal oC
    signal oD
    signal oE
    signal oF

    o0 = op4 == 0x0
    o1 = op4 == 0x1
    o2 = op4 == 0x2
    o3 = op4 == 0x3
    o4 = op4 == 0x4
    o5 = op4 == 0x5
    o6 = op4 == 0x6
    o7 = op4 == 0x7
    o8 = op4 == 0x8
    o9 = op4 == 0x9
    oA = op4 == 0xA
    oB = op4 == 0xB
    oC = op4 == 0xC
    oD = op4 == 0xD
    oE = op4 == 0xE
    oF = op4 == 0xF

    # ---- 0x00-0x0F data / memory ----
    signal i_NOP
    signal i_MOV
    signal i_LDI0
    signal i_LDI1
    signal i_LDX
    signal i_STX
    signal i_LDY
    signal i_STY
    signal i_LDXP
    signal i_STXP
    signal i_LDYP
    signal i_STYP
    signal i_SETXL
    signal i_SETXH
    signal i_SETYL
    signal i_SETYH

    i_NOP = g0 and o0
    i_MOV = g0 and o1
    i_LDI0 = g0 and o2
    i_LDI1 = g0 and o3
    i_LDX = g0 and o4
    i_STX = g0 and o5
    i_LDY = g0 and o6
    i_STY = g0 and o7
    i_LDXP = g0 and o8
    i_STXP = g0 and o9
    i_LDYP = g0 and oA
    i_STYP = g0 and oB
    i_SETXL = g0 and oC
    i_SETXH = g0 and oD
    i_SETYL = g0 and oE
    i_SETYH = g0 and oF

    # ---- 0x10-0x1F ALU ----
    signal i_ADD
    signal i_ADC
    signal i_SUB
    signal i_SBC
    signal i_CMP
    signal i_AND
    signal i_OR
    signal i_XOR
    signal i_NOT
    signal i_NEG
    signal i_INC
    signal i_DEC
    signal i_ADDI
    signal i_SUBI
    signal i_CMPI
    signal i_TEST

    i_ADD = g1 and o0
    i_ADC = g1 and o1
    i_SUB = g1 and o2
    i_SBC = g1 and o3
    i_CMP = g1 and o4
    i_AND = g1 and o5
    i_OR = g1 and o6
    i_XOR = g1 and o7
    i_NOT = g1 and o8
    i_NEG = g1 and o9
    i_INC = g1 and oA
    i_DEC = g1 and oB
    i_ADDI = g1 and oC
    i_SUBI = g1 and oD
    i_CMPI = g1 and oE
    i_TEST = g1 and oF

    # ---- 0x20-0x2F shift / bit / stack ----
    signal i_SHL
    signal i_SHR
    signal i_SAR
    signal i_ROL
    signal i_ROR
    signal i_RCL
    signal i_RCR
    signal i_SWAP
    signal i_BTST
    signal i_BSET
    signal i_BCLR
    signal i_BTGL
    signal i_CLC
    signal i_SEC
    signal i_PUSH
    signal i_POP

    i_SHL = g2 and o0
    i_SHR = g2 and o1
    i_SAR = g2 and o2
    i_ROL = g2 and o3
    i_ROR = g2 and o4
    i_RCL = g2 and o5
    i_RCR = g2 and o6
    i_SWAP = g2 and o7
    i_BTST = g2 and o8
    i_BSET = g2 and o9
    i_BCLR = g2 and oA
    i_BTGL = g2 and oB
    i_CLC = g2 and oC
    i_SEC = g2 and oD
    i_PUSH = g2 and oE
    i_POP = g2 and oF

    # ---- 0x30-0x3F control flow ----
    signal i_JMP
    signal i_JZ
    signal i_JNZ
    signal i_JC
    signal i_JNC
    signal i_JN
    signal i_JNN
    signal i_JV
    signal i_JNV
    signal i_JLT
    signal i_JGE
    signal i_CALL
    signal i_RET
    signal i_JMPX
    signal i_CALLX
    signal i_HALT

    i_JMP = g3 and o0
    i_JZ = g3 and o1
    i_JNZ = g3 and o2
    i_JC = g3 and o3
    i_JNC = g3 and o4
    i_JN = g3 and o5
    i_JNN = g3 and o6
    i_JV = g3 and o7
    i_JNV = g3 and o8
    i_JLT = g3 and o9
    i_JGE = g3 and oA
    i_CALL = g3 and oB
    i_RET = g3 and oC
    i_JMPX = g3 and oD
    i_CALLX = g3 and oE
    i_HALT = g3 and oF

    # ---- Register file ----
    signal reg_a: 8
    signal reg_b: 8
    signal reg_wb: 8
    signal reg_we
    signal r0q: 8
    signal r1q: 8
    signal r2q: 8
    signal r3q: 8
    signal r4q: 8
    signal r5q: 8
    signal r6q: 8
    signal r7q: 8

    component regs = RW8_REGFILE8(D=reg_wb, WE=reg_we, RD0=rd0, RD1=rd1, RD2=rd2, RA0=rd0, RA1=rd1, RA2=rd2, RB0=rs0, RB1=rs1, RB2=rs2, CLK=CLK, RESET=RESET, A=reg_a, B=reg_b, R0=r0q, R1=r1q, R2=r2q, R3=r3q, R4=r4q, R5=r5q, R6=r6q, R7=r7q)

    # ---- ALU and shift/bit units ----
    signal alu_resulths: 8
    signal alu_result: 8
    signal alu_flag_z
    signal alu_flag_c
    signal alu_flag_n
    signal alu_flag_v

    alu_resulths = (imm7_se if (i_ADDI or i_SUBI or i_CMPI) else reg_b)
    component alu = RW8_ALU8(A=reg_a, B=alu_resulths, OP=op4, CIN=flag_c, R=alu_result, Z=alu_flag_z, C=alu_flag_c, N=alu_flag_n, V=alu_flag_v)

    signal shift_r: 8
    signal shift_z
    signal shift_n
    signal shift_c
    signal bit_zero
    component shiftbit = RW8_SHIFTBIT8(A=reg_a, OP=op4, OLD_C=flag_c, BIT0=rs0, BIT1=rs1, BIT2=rs2, R=shift_r, Z_RESULT=shift_z, N_RESULT=shift_n, C_SHIFT=shift_c, BIT_ZERO=bit_zero)

    # ---- Register writeback ----
    signal data_reg_write
    signal alu_resulteg_write
    signal shift_reg_write
    signal data_wb: 8
    signal shift_wb: 8

    data_reg_write = i_MOV or i_LDI0 or i_LDI1 or i_LDX or i_LDY or i_LDXP or i_LDYP
    alu_resulteg_write = g1 and not i_CMP and not i_CMPI and not i_TEST
    shift_reg_write = i_SHL or i_SHR or i_SAR or i_ROL or i_ROR or i_RCL or i_RCR or i_SWAP or i_BSET or i_BCLR or i_BTGL or i_POP

    data_wb = (reg_b if i_MOV else (ldi0_value if i_LDI0 else (ldi1_value if i_LDI1 else (DMEM_IN if (i_LDX or i_LDY or i_LDXP or i_LDYP) else 0x00))))
    shift_wb = (DMEM_IN if i_POP else shift_r)
    reg_wb = (data_wb if g0 else (alu_result if g1 else (shift_wb if g2 else 0x00)))
    reg_we = exec and (data_reg_write or alu_resulteg_write or shift_reg_write)

    # ---- X / Y increments and writes ----
    signal x_inc_lo: 8
    signal x_inc_hi: 8
    signal x_inc_c
    signal y_inc_lo: 8
    signal y_inc_hi: 8
    signal y_inc_c
    signal x_auto
    signal y_auto

    x_inc_lo = x_lo + 0x01
    x_inc_c = x_inc_lo < x_lo
    x_inc_hi = x_hi + ((0x01 if x_inc_c else 0x00))
    y_inc_lo = y_lo + 0x01
    y_inc_c = y_inc_lo < y_lo
    y_inc_hi = y_hi + ((0x01 if y_inc_c else 0x00))

    x_auto = exec and (i_LDXP or i_STXP)
    y_auto = exec and (i_LDYP or i_STYP)

    x_we = x_auto or (exec and (i_SETXL or i_SETXH))
    y_we = y_auto or (exec and (i_SETYL or i_SETYH))

    x_d_lo = (reg_b if (exec and i_SETXL) else (x_inc_lo if x_auto else x_lo))
    x_d_hi = (reg_b if (exec and i_SETXH) else (x_inc_hi if x_auto else x_hi))
    y_d_lo = (reg_b if (exec and i_SETYL) else (y_inc_lo if y_auto else y_lo))
    y_d_hi = (reg_b if (exec and i_SETYH) else (y_inc_hi if y_auto else y_hi))

    # ---- Stack pointer arithmetic ----
    signal sp_inc_lo: 8
    signal sp_inc_hi: 8
    signal sp_inc_c
    signal sp_dec_lo: 8
    signal sp_dec_hi: 8
    signal sp_dec_b
    signal sp_dec_event
    signal sp_inc_event

    sp_inc_lo = sp_lo + 0x01
    sp_inc_c = sp_inc_lo < sp_lo
    sp_inc_hi = sp_hi + ((0x01 if sp_inc_c else 0x00))

    sp_dec_lo = sp_lo - 0x01
    sp_dec_b = sp_lo == 0x00
    sp_dec_hi = sp_hi - ((0x01 if sp_dec_b else 0x00))

    sp_dec_event = (exec and i_PUSH) or (exec and (i_CALL or i_CALLX)) or call2
    sp_inc_event = (exec and i_POP) or (exec and i_RET) or ret2
    sp_we = sp_dec_event or sp_inc_event
    sp_d_lo = (sp_dec_lo if sp_dec_event else sp_inc_lo)
    sp_d_hi = (sp_dec_hi if sp_dec_event else sp_inc_hi)

    ret_capture = exec and i_RET

    # ---- Data-memory interface ----
    signal x_mem
    signal y_mem
    signal load_mem
    signal store_mem
    signal stack_write
    signal stack_read
    signal dmem_addr_lo_i: 8
    signal dmem_addr_hi_i: 8
    signal dmem_out_i: 8
    signal dmem_write_i
    signal dmem_read_i

    x_mem = exec and (i_LDX or i_STX or i_LDXP or i_STXP)
    y_mem = exec and (i_LDY or i_STY or i_LDYP or i_STYP)
    load_mem = exec and (i_LDX or i_LDY or i_LDXP or i_LDYP)
    store_mem = exec and (i_STX or i_STY or i_STXP or i_STYP)

    stack_write = (exec and i_PUSH) or (exec and (i_CALL or i_CALLX)) or call2
    stack_read = (exec and (i_POP or i_RET)) or ret2

    dmem_addr_lo_i = (sp_dec_lo if stack_write else (sp_lo if stack_read else (y_lo if y_mem else (x_lo if x_mem else 0x00))))
    dmem_addr_hi_i = (sp_dec_hi if stack_write else (sp_hi if stack_read else (y_hi if y_mem else (x_hi if x_mem else 0x00))))

    dmem_out_i = (pc_lo if call2 else (pc_hi if (exec and (i_CALL or i_CALLX)) else (reg_b if (exec and i_PUSH) else (reg_b if store_mem else 0x00))))
    dmem_write_i = store_mem or stack_write
    dmem_read_i = load_mem or stack_read

    # ---- PC increment and signed relative target ----
    signal pc_inc_lo: 8
    signal pc_inc_hi: 8
    signal pc_inc_c
    signal rel_lo: 8
    signal rel_hi: 8
    signal rel_c

    pc_inc_lo = pc_lo + 0x01
    pc_inc_c = pc_inc_lo < pc_lo
    pc_inc_hi = pc_hi + ((0x01 if pc_inc_c else 0x00))

    rel_lo = pc_lo + ir_lo
    rel_c = rel_lo < pc_lo
    rel_hi = pc_hi + rel_off_hi + ((0x01 if rel_c else 0x00))

    # ---- Branch conditions ----
    signal signed_less
    signal take_rel
    signal take_x

    signed_less = flag_n xor flag_v
    take_rel = exec and (i_JMP or (i_JZ and flag_z) or (i_JNZ and not flag_z) or (i_JC and flag_c) or (i_JNC and not flag_c) or (i_JN and flag_n) or (i_JNN and not flag_n) or (i_JV and flag_v) or (i_JNV and not flag_v) or (i_JLT and signed_less) or (i_JGE and not signed_less))
    take_x = exec and i_JMPX

    pc_write = fetch or take_rel or take_x or call2 or ret2
    next_pc_lo = (return_lo_saved if ret2 else (((x_lo if i_CALLX else rel_lo)) if call2 else (x_lo if take_x else (rel_lo if take_rel else pc_inc_lo))))
    next_pc_hi = (DMEM_IN if ret2 else (((x_hi if i_CALLX else rel_hi)) if call2 else (x_hi if take_x else (rel_hi if take_rel else pc_inc_hi))))

    # ---- Flags ----
    signal shift_zn_we
    signal shift_n_we
    signal shift_c_we
    signal shift_any_flag_we
    signal next_z
    signal next_c
    signal next_n
    signal next_v

    shift_zn_we = g2 and (o0 or o1 or o2 or o3 or o4 or o5 or o6 or o7 or o8 or o9 or oA or oB)
    shift_n_we = g2 and (o0 or o1 or o2 or o3 or o4 or o5 or o6 or o7 or o9 or oA or oB)
    shift_c_we = g2 and (o0 or o1 or o2 or o3 or o4 or o5 or o6)
    shift_any_flag_we = g2 and (o0 or o1 or o2 or o3 or o4 or o5 or o6 or o7 or o8 or o9 or oA or oB or oC or oD)

    next_z = (alu_flag_z if g1 else (bit_zero if (g2 and o8) else (shift_z if shift_zn_we else flag_z)))
    next_n = (alu_flag_n if g1 else (shift_n if shift_n_we else flag_n))
    next_c = (alu_flag_c if g1 else (shift_c if shift_c_we else (0 if i_CLC else (1 if i_SEC else flag_c))))
    next_v = (alu_flag_v if g1 else flag_v)

    flags_d = join(0, 0, 0, 0, next_v, next_n, next_c, next_z)
    flags_we = exec and (g1 or shift_any_flag_we)

    # ---- Sequencer next state ----
    state_d = (0x01 if fetch else (((0x04 if i_HALT else ((0x02 if (i_CALL or i_CALLX) else ((0x03 if i_RET else 0x00)))))) if exec else (0x00 if call2 else (0x00 if ret2 else 0x04))))

    # ---- External and debug outputs ----
    IMEM_ADDR_LO = pc_lo
    IMEM_ADDR_HI = pc_hi

    DMEM_ADDR_LO = dmem_addr_lo_i
    DMEM_ADDR_HI = dmem_addr_hi_i
    DMEM_OUT = dmem_out_i
    DMEM_WRITE = dmem_write_i
    DMEM_READ = dmem_read_i

    HALTED = halted_state
    FLAGS = flags_q[3:0]
    STATE = state_q

    DBG_PC_LO = pc_lo
    DBG_PC_HI = pc_hi
    DBG_IR_LO = ir_lo
    DBG_IR_HI = ir_hi
    DBG_X_LO = x_lo
    DBG_X_HI = x_hi
    DBG_Y_LO = y_lo
    DBG_Y_HI = y_hi
    DBG_SP_LO = sp_lo
    DBG_SP_HI = sp_hi

    DBG_R0 = r0q
    DBG_R1 = r1q
    DBG_R2 = r2q
    DBG_R3 = r3q
    DBG_R4 = r4q
    DBG_R5 = r5q
    DBG_R6 = r6q
    DBG_R7 = r7q
