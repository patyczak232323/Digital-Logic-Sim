# Rewired-8 ALU for opcodes 0x10-0x1F.
# A is Rd. B is Rs or the sign-extended immediate selected by the core.
# C follows RW8 borrow semantics for subtraction: C=1 means borrow.
circuit RW8_ALU8:
    input A: 8, B: 8
    input OP: 4
    input CIN

    output R: 8
    output Z, C, N, V

    signal add0: 8
    signal adc: 8
    signal sub: 8
    signal sbc_b: 8
    signal sbc: 8
    signal andv: 8
    signal orv: 8
    signal xorv: 8
    signal notv: 8
    signal negv: 8
    signal incv: 8
    signal decv: 8
    signal result: 8

    signal add_c
    signal adc_c0
    signal adc_c1
    signal adc_c
    signal sub_c
    signal sbc_b_c
    signal sbc_c
    signal neg_c
    signal inc_c
    signal dec_c

    signal add_v
    signal adc_v
    signal sub_v
    signal sbc_v
    signal ov_neg
    signal ov_inc
    signal ov_dec

    add0 = A + B
    adc = add0 + ((0x01 if CIN else 0x00))
    sub = A - B
    sbc_b = B + ((0x01 if CIN else 0x00))
    sbc = A - sbc_b

    andv = A and B
    orv = A or B
    xorv = A xor B
    notv = not A
    negv = 0x00 - A
    incv = A + 0x01
    decv = A - 0x01

    add_c = add0 < A
    adc_c0 = add0 < A
    adc_c1 = adc < add0
    adc_c = adc_c0 or adc_c1
    sub_c = A < B
    sbc_b_c = sbc_b < B
    sbc_c = sbc_b_c or (A < sbc_b)
    neg_c = 0x00 < A
    inc_c = incv < A
    dec_c = A == 0x00

    add_v = not (A[7] xor B[7]) and (add0[7] xor A[7])
    adc_v = not (A[7] xor B[7]) and (adc[7] xor A[7])
    sub_v = (A[7] xor B[7]) and (sub[7] xor A[7])
    sbc_v = (A[7] xor B[7]) and (sbc[7] xor A[7])
    ov_neg = A == 0x80
    ov_inc = A == 0x7F
    ov_dec = A == 0x80

    result = (add0 if OP == 0x0 else (adc if OP == 0x1 else (sub if OP == 0x2 else (sbc if OP == 0x3 else (sub if OP == 0x4 else (andv if OP == 0x5 else (orv if OP == 0x6 else (xorv if OP == 0x7 else (notv if OP == 0x8 else (negv if OP == 0x9 else (incv if OP == 0xA else (decv if OP == 0xB else (add0 if OP == 0xC else (sub if OP == 0xD else (sub if OP == 0xE else andv)))))))))))))))

    R = result
    Z = result == 0x00
    N = result[7]

    C = (add_c if OP == 0x0 else (adc_c if OP == 0x1 else (sub_c if OP == 0x2 else (sbc_c if OP == 0x3 else (sub_c if OP == 0x4 else (0 if OP == 0x5 else (0 if OP == 0x6 else (0 if OP == 0x7 else (0 if OP == 0x8 else (neg_c if OP == 0x9 else (inc_c if OP == 0xA else (dec_c if OP == 0xB else (add_c if OP == 0xC else (sub_c if OP == 0xD else (sub_c if OP == 0xE else 0)))))))))))))))

    V = (add_v if OP == 0x0 else (adc_v if OP == 0x1 else (sub_v if OP == 0x2 else (sbc_v if OP == 0x3 else (sub_v if OP == 0x4 else (0 if OP == 0x5 else (0 if OP == 0x6 else (0 if OP == 0x7 else (0 if OP == 0x8 else (ov_neg if OP == 0x9 else (ov_inc if OP == 0xA else (ov_dec if OP == 0xB else (add_v if OP == 0xC else (sub_v if OP == 0xD else (sub_v if OP == 0xE else 0)))))))))))))))
