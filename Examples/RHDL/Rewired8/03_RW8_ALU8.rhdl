# Rewired-8 ALU for opcodes 0x10-0x1F.
# A is Rd. B is Rs or the sign-extended immediate selected by the core.
# C follows RW8 borrow semantics for subtraction: C=1 means borrow.
circuit RW8_ALU8
    input A: 8, B: 8
    input OP: 4
    input CIN

    output R: 8
    output Z, C, N, V

    signal add0: 8
    signal adc: 8
    signal sub: 8
    signal sbc_b: 8
    signal sbc: 8
    signal andv: 8
    signal orv: 8
    signal xorv: 8
    signal notv: 8
    signal negv: 8
    signal incv: 8
    signal decv: 8
    signal result: 8

    signal add_c
    signal adc_c0
    signal adc_c1
    signal adc_c
    signal sub_c
    signal sbc_b_c
    signal sbc_c
    signal neg_c
    signal inc_c
    signal dec_c

    signal add_v
    signal adc_v
    signal sub_v
    signal sbc_v
    signal ov_neg
    signal ov_inc
    signal ov_dec

    add0 = A + B
    adc = add0 + (choose(CIN, 0x01, 0x00))
    sub = A - B
    sbc_b = B + (choose(CIN, 0x01, 0x00))
    sbc = A - sbc_b

    andv = A and B
    orv = A or B
    xorv = A xor B
    notv = not A
    negv = 0x00 - A
    incv = A + 0x01
    decv = A - 0x01

    add_c = add0 < A
    adc_c0 = add0 < A
    adc_c1 = adc < add0
    adc_c = adc_c0 or adc_c1
    sub_c = A < B
    sbc_b_c = sbc_b < B
    sbc_c = sbc_b_c or (A < sbc_b)
    neg_c = 0x00 < A
    inc_c = incv < A
    dec_c = A == 0x00

    add_v = not (A[7] xor B[7]) and (add0[7] xor A[7])
    adc_v = not (A[7] xor B[7]) and (adc[7] xor A[7])
    sub_v = (A[7] xor B[7]) and (sub[7] xor A[7])
    sbc_v = (A[7] xor B[7]) and (sbc[7] xor A[7])
    ov_neg = A == 0x80
    ov_inc = A == 0x7F
    ov_dec = A == 0x80

    result = choose(OP == 0x0, add0, choose(OP == 0x1, adc, choose(OP == 0x2, sub, choose(OP == 0x3, sbc, choose(OP == 0x4, sub, choose(OP == 0x5, andv, choose(OP == 0x6, orv, choose(OP == 0x7, xorv, choose(OP == 0x8, notv, choose(OP == 0x9, negv, choose(OP == 0xA, incv, choose(OP == 0xB, decv, choose(OP == 0xC, add0, choose(OP == 0xD, sub, choose(OP == 0xE, sub, andv)))))))))))))))

    R = result
    Z = result == 0x00
    N = result[7]

    C = choose(OP == 0x0, add_c, choose(OP == 0x1, adc_c, choose(OP == 0x2, sub_c, choose(OP == 0x3, sbc_c, choose(OP == 0x4, sub_c, choose(OP == 0x5, 0, choose(OP == 0x6, 0, choose(OP == 0x7, 0, choose(OP == 0x8, 0, choose(OP == 0x9, neg_c, choose(OP == 0xA, inc_c, choose(OP == 0xB, dec_c, choose(OP == 0xC, add_c, choose(OP == 0xD, sub_c, choose(OP == 0xE, sub_c, 0)))))))))))))))

    V = choose(OP == 0x0, add_v, choose(OP == 0x1, adc_v, choose(OP == 0x2, sub_v, choose(OP == 0x3, sbc_v, choose(OP == 0x4, sub_v, choose(OP == 0x5, 0, choose(OP == 0x6, 0, choose(OP == 0x7, 0, choose(OP == 0x8, 0, choose(OP == 0x9, ov_neg, choose(OP == 0xA, ov_inc, choose(OP == 0xB, ov_dec, choose(OP == 0xC, add_v, choose(OP == 0xD, sub_v, choose(OP == 0xE, sub_v, 0)))))))))))))))
end
