# Rewired-8 shift/bit execution block for opcodes 0x20-0x2B.
# Flag write policy is selected in RW8_CORE; this block only produces candidates.
circuit RW8_SHIFTBIT8
    input A: 8
    input OP: 4
    input OLD_C
    input BIT0, BIT1, BIT2

    output R: 8
    output Z_RESULT
    output N_RESULT
    output C_SHIFT
    output BIT_ZERO

    signal shl: 8
    signal shr: 8
    signal sar: 8
    signal rol: 8
    signal ror: 8
    signal rcl: 8
    signal rcr: 8
    signal swap: 8
    signal mask: 8
    signal tested: 8
    signal bset: 8
    signal bclr: 8
    signal btgl: 8
    signal result: 8

    shl = A << 1
    shr = A >> 1
    sar = join(A[7], A[7], A[6], A[5], A[4], A[3], A[2], A[1])
    rol = join(A[6], A[5], A[4], A[3], A[2], A[1], A[0], A[7])
    ror = join(A[0], A[7], A[6], A[5], A[4], A[3], A[2], A[1])
    rcl = join(A[6], A[5], A[4], A[3], A[2], A[1], A[0], OLD_C)
    rcr = join(OLD_C, A[7], A[6], A[5], A[4], A[3], A[2], A[1])
    swap = join(A[3:0], A[7:4])

    mask = choose(BIT2, choose(BIT1, choose(BIT0, 0x80, 0x40), choose(BIT0, 0x20, 0x10)), choose(BIT1, choose(BIT0, 0x08, 0x04), choose(BIT0, 0x02, 0x01)))
    tested = A and mask
    bset = A or mask
    bclr = A and not mask
    btgl = A xor mask

    result = choose(OP == 0x0, shl, choose(OP == 0x1, shr, choose(OP == 0x2, sar, choose(OP == 0x3, rol, choose(OP == 0x4, ror, choose(OP == 0x5, rcl, choose(OP == 0x6, rcr, choose(OP == 0x7, swap, choose(OP == 0x9, bset, choose(OP == 0xA, bclr, choose(OP == 0xB, btgl, A)))))))))))

    R = result
    Z_RESULT = result == 0x00
    N_RESULT = result[7]
    C_SHIFT = choose(OP == 0x0, A[7], choose(OP == 0x1, A[0], choose(OP == 0x2, A[0], choose(OP == 0x3, A[7], choose(OP == 0x4, A[0], choose(OP == 0x5, A[7], choose(OP == 0x6, A[0], OLD_C)))))))
    BIT_ZERO = tested == 0x00
end
