# Rewired-8: R0-R7, two asynchronous read ports and one clocked write port.
# Register addresses are three individual bits because RHDL v0.5 buses are 1/4/8-bit.
circuit RW8_REGFILE8:
    input D: 8
    input WE
    input RD0, RD1, RD2
    input RA0, RA1, RA2
    input RB0, RB1, RB2
    input CLK, RESET

    output A: 8, B: 8
    output R0: 8, R1: 8, R2: 8, R3: 8
    output R4: 8, R5: 8, R6: 8, R7: 8

    signal q0: 8
    signal q1: 8
    signal q2: 8
    signal q3: 8
    signal q4: 8
    signal q5: 8
    signal q6: 8
    signal q7: 8

    signal we0
    signal we1
    signal we2
    signal we3
    signal we4
    signal we5
    signal we6
    signal we7

    we0 = WE and not RD2 and not RD1 and not RD0
    we1 = WE and not RD2 and not RD1 and RD0
    we2 = WE and not RD2 and RD1 and not RD0
    we3 = WE and not RD2 and RD1 and RD0
    we4 = WE and RD2 and not RD1 and not RD0
    we5 = WE and RD2 and not RD1 and RD0
    we6 = WE and RD2 and RD1 and not RD0
    we7 = WE and RD2 and RD1 and RD0

    component cell0 = RW8_REG8(D=D, WE=we0, CLK=CLK, RESET=RESET, Q=q0)
    component cell1 = RW8_REG8(D=D, WE=we1, CLK=CLK, RESET=RESET, Q=q1)
    component cell2 = RW8_REG8(D=D, WE=we2, CLK=CLK, RESET=RESET, Q=q2)
    component cell3 = RW8_REG8(D=D, WE=we3, CLK=CLK, RESET=RESET, Q=q3)
    component cell4 = RW8_REG8(D=D, WE=we4, CLK=CLK, RESET=RESET, Q=q4)
    component cell5 = RW8_REG8(D=D, WE=we5, CLK=CLK, RESET=RESET, Q=q5)
    component cell6 = RW8_REG8(D=D, WE=we6, CLK=CLK, RESET=RESET, Q=q6)
    component cell7 = RW8_REG8(D=D, WE=we7, CLK=CLK, RESET=RESET, Q=q7)

    A = (((((q7 if RA0 else q6)) if RA1 else ((q5 if RA0 else q4)))) if RA2 else ((((q3 if RA0 else q2)) if RA1 else ((q1 if RA0 else q0)))))
    B = (((((q7 if RB0 else q6)) if RB1 else ((q5 if RB0 else q4)))) if RB2 else ((((q3 if RB0 else q2)) if RB1 else ((q1 if RB0 else q0)))))

    R0 = q0
    R1 = q1
    R2 = q2
    R3 = q3
    R4 = q4
    R5 = q5
    R6 = q6
    R7 = q7
