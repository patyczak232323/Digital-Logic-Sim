# Rewired-8: 8-bit edge-clocked register.
# Built from eight NAND-based DffBit instances. No RAM primitive is used.
# RESET is synchronous.
circuit RW8_REG8
    input D: 8
    input WE, CLK, RESET
    output Q: 8

    signal q0, q1, q2, q3, q4, q5, q6, q7
    signal d0, d1, d2, d3, d4, d5, d6, d7
    signal n0, n1, n2, n3, n4, n5, n6, n7

    d0 = choose(RESET, 0, choose(WE, D[0], q0))
    d1 = choose(RESET, 0, choose(WE, D[1], q1))
    d2 = choose(RESET, 0, choose(WE, D[2], q2))
    d3 = choose(RESET, 0, choose(WE, D[3], q3))
    d4 = choose(RESET, 0, choose(WE, D[4], q4))
    d5 = choose(RESET, 0, choose(WE, D[5], q5))
    d6 = choose(RESET, 0, choose(WE, D[6], q6))
    d7 = choose(RESET, 0, choose(WE, D[7], q7))

    component b0 : DffBit(D=d0, CLK=CLK, Q=q0, NOT_Q=n0)
    component b1 : DffBit(D=d1, CLK=CLK, Q=q1, NOT_Q=n1)
    component b2 : DffBit(D=d2, CLK=CLK, Q=q2, NOT_Q=n2)
    component b3 : DffBit(D=d3, CLK=CLK, Q=q3, NOT_Q=n3)
    component b4 : DffBit(D=d4, CLK=CLK, Q=q4, NOT_Q=n4)
    component b5 : DffBit(D=d5, CLK=CLK, Q=q5, NOT_Q=n5)
    component b6 : DffBit(D=d6, CLK=CLK, Q=q6, NOT_Q=n6)
    component b7 : DffBit(D=d7, CLK=CLK, Q=q7, NOT_Q=n7)

    Q = join(q7, q6, q5, q4, q3, q2, q1, q0)
end
